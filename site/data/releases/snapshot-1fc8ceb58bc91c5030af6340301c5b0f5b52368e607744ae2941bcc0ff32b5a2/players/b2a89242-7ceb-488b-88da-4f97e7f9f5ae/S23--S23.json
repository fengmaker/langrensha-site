弃票。","拿狼率以已知个人阵营出场为分母，未知阵营排除；狼人自爆率只按明确的主动自爆事件计数并按选手每局去重；好人、狼人上警率和警下率按每局首次报名及已知警上/警下名单统计，阵营或名单未知时排除。","本筛选范围有 4 轮适用对局的警徽候选名单缺失；2 轮有同轮投给唯一信息神的资格证据，其余 2 轮排除；另有 0 轮版型未配置预言家或通灵师，不适用。"],"rankings":{"points":null,"appearances":null,"attendance":null,"total_win_rate":null,"wins":null,"losses":null,"werewolf_win_rate":null,"good_win_rate":null,"sheriff_registration_rate":null,"seer_follow_rate":null,"sheriff_seer_vote_rate":null,"good_wins":null,"wolf_vote_rate":null,"good_sheriff_registration_rate":null,"werewolf_appearances":null,"werewolf_wins":null,"werewolf_draw_rate":null,"werewolf_self_explosion_rate":null,"werewolf_sheriff_registration_rate":null,"bluff_count":null,"bluff_rate":null,"bluff_success_rate":null},"boards":[]},"scope":{"season":"S23","season_start":"S23","season_end":"S23","seasons":["S23"],"minimum_appearances":0,"phase":"all","games":99},"available_seasons":["S21","S22","S23"],"bluff_publications":[{"season":"S23","publication_id":"bluff-441be2833b0c033546e847520570294ace60b899991d7595fd3905779526f244","payload_hash":"37af72468ea2027943ddd88771e4867a138ddc55d0efb491b52e4bb86b69905a"}]}
