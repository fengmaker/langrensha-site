":0,"denominator":0,"rate":null,"excluded":0,"game_ids":[],"samples":[]},"roles":[],"ledger":[],"notes":["胜负依据每位玩家的个人胜利阵营与整局胜方；混血按其个人胜利阵营计分。","整季榜累计全部正式对局积分；狼人胜 +1.5，好人胜 +1，个人败 -1。决赛周冠军榜只累计决赛周对局。","站边率只计算放逐票中好人且身份不是预言家或通灵师，并且双方同轮都有票权的轮次；按该局唯一的预言家或通灵师的明确投向比较，弃票算失败，缺失投票记录列为排除。","警徽票率只计算好人（预言家本人除外）有票权且该局唯一的预言家或通灵师是合法候选的轮次；PK 和技能复投均计入，明确弃票算失败。","版型没有预言家或通灵师时不适用这两类比例；身份未记录或信息神不唯一时无法判定，符合票权条件的样本列为排除。","候选名单缺失时，仅用同轮实际投向该局唯一预言家或通灵师的选票作为其可参选证据；没有该证据的轮次按缺失排除，每位玩家只在其为好人且有票权时增加排除数。","每项比例附带对应对局列表，方便回查分母；无法判定的战绩保留为待定，不按败场或零分处理。","混血儿阵营缺失时依据本局唯一榜样的个人胜利阵营推导；已记录的阵营说明必须一致。","投狼率计算有票权的好人放逐票，包含预言家和通灵师；盗宝大师（含盗宝毒师、盗宝蒙面等）始终属于狼人阵营，即使当夜选平民也不改变阵营。其选票不计入投狼次数、投狼率或其他好人指标，好人投向盗宝身份计为投中狼人。PK及技能复投逐轮计入，明确弃票算失败，缺失选票及目标阵营未知时排除。放逐弃票次数只计好人放逐票中的明确弃票，包括规则默认弃票。","拿狼率以已知个人阵营出场为分母，未知阵营排除；狼人自爆率只按明确的主动自爆事件计数并按选手每局去重；好人、狼人上警率和警下率按每局首次报名及已知警上/警下名单统计，阵营或名单未知时排除。","本筛选范围有 16 轮适用对局的警徽候选名单缺失；11 轮有同轮投给唯一信息神的资格证据，其余 5 轮排除；另有 1 轮版型未配置预言家或通灵师，不适用。"],"rankings":{"points":null,"appearances":null,"attendance":null,"total_win_rate":null,"wins":null,"losses":null,"werewolf_win_rate":null,"good_win_rate":null,"sheriff_registration_rate":null,"seer_follow_rate":null,"sheriff_seer_vote_rate":null,"good_wins":null,"wolf_vote_rate":null,"good_sheriff_registration_rate":null,"werewolf_appearances":null,"werewolf_wins":null,"werewolf_draw_rate":null,"werewolf_self_explosion_rate":null,"werewolf_sheriff_registration_rate":null,"bluff_count":null,"bluff_rate":null,"bluff_success_rate":null},"boards":[]},"scope":{"season":"S22","season_start":"S21","season_end":"S22","seasons":["S21","S22"],"minimum_appearances":0,"phase":"all","games":270},"available_seasons":["S21","S22","S23"],"bluff_publications":[{"season":"S21","publication_id":null,"payload_hash":null},{"season":"S22","publication_id":"bluff-b2c6711eca31e996013e3f1bebdfd7e9957779b4d6da2e4c2951b38ca1c5395f","payload_hash":"682de440df495ec4a602d8ff53523bade90bbd40c99d91d4910cefb1cbe46309"}]}
